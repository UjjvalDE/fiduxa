PORT=3100
NODE_ENV=development

# Frontend origin(s) allowed by CORS – comma-separated. Next.js dev runs on 3000.
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/fiduxa

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fiduxa <no-reply@example.com>"

# Optional: internal inbox for new requests, cancellations and issue reports
ADMIN_NOTIFICATION_EMAIL=

# Contact address printed on invoices ("Email: …") and the default for
# Admin → Einstellungen → Rechnungen. Plain address only, no display name.
# Unset → the bare address from SMTP_FROM is used. Set it in production
# (e.g. rechnung@your-domain.de) so invoices show a proper contact address.
INVOICE_EMAIL=

# E-mail delivery: "background" (default) – requests only enqueue mails in the
# outbox; the emailOutbox job (API with RUN_JOBS_IN_API, or `npm run worker`)
# sends them within seconds. "inline" – legacy: send inside the request.
# EMAIL_DELIVERY=background

WORKER_INVITATION_URL=http://localhost:3000/worker/einladung
# Optional – defaults to CLIENT_URL/passwort-zuruecksetzen
PASSWORD_RESET_URL=

# 64 hex characters (openssl rand -hex 32). Never change once bank data exists.
BANK_DETAILS_ENCRYPTION_KEY=

# Optional business settings
# Default hourly price (cents). The admin can change it any time in Admin → Einstellungen.
HOURLY_RATE_CENTS=2500
SLOT_HOLD_MINUTES=35
CANCELLATION_CUTOFF_HOURS=24

# Set to 1 when running behind Caddy/Nginx so rate limits see real client IPs
TRUST_PROXY=

# ---------- Online payments (Stripe) ----------
# Leave empty to disable online payment (customers see "pay by invoice").
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3100/api/v1/payments/webhook`
# or Dashboard → Developers → Webhooks (events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired)
STRIPE_WEBHOOK_SECRET=
# Public website origin for Stripe success/cancel redirects (defaults to CLIENT_URL)
PUBLIC_SITE_URL=http://localhost:3000

# Development/testing only: send Stripe API calls to stripe-mock
# STRIPE_API_BASE=http://localhost:12111

# ---------- Online payments (PayPal) ----------
# REST app credentials from https://developer.paypal.com/dashboard/applications
# Sandbox (test money) – used unless PAYPAL_MODE=live
PAYPALAPIKEY=
PAYPALSECRET_KEY=
# Live (real money) – only used with PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
# sandbox (default) or live
PAYPAL_MODE=sandbox
# Tests only: send PayPal calls to a local mock
# PAYPAL_API_BASE=http://127.0.0.1:4010
# Webhook id from Developer Dashboard → App → Webhooks (event CHECKOUT.ORDER.APPROVED,
# URL https://<api>/api/v1/payments/paypal/webhook). Without it the webhook answers 503.
PAYPAL_WEBHOOK_ID=
# Tests only (NODE_ENV=test): PAYPAL_WEBHOOK_SKIP_VERIFY=1 skips the signature check
# Dev/test only: PAYPAL_SIMULATE=true shows "Simulate PayPal approval (dev)" on the
# payment pages and completes orders without a PayPal login. Refused unless
# NODE_ENV is development or test (never in production/staging, never with live keys).
# PAYPAL_SIMULATE=true

# ---------- Tax ----------
# VAT contained in consumer prices (0.19 = 19 %, 0 for Kleinunternehmer). Admin can change it in Einstellungen.
VAT_RATE=0.19

# ---------- Cleaner pay ----------
# Default hourly pay for cleaners (cents); admins can set an individual rate
WORKER_HOURLY_RATE_CENTS=1800
# Days after a completed job until the payout is due
WORKER_PAYOUT_DELAY_DAYS=30

# Job dispatch
# Gap a cleaner needs between two jobs (travel). Used for dispatch, the slot
# list and the server-side "no overlapping jobs" check. Admin can override it
# via PUT /admin/settings { booking: { travelBufferMinutes } }.
# Slot list: SLOT_CAPACITY_MODE=cleaners (default; only times with a free
# eligible cleaner) or window (admin window capacity only).
# SLOT_UNASSIGNED_CONSUMES_CLEANER=true, SLOT_RESPECT_WORKING_HOURS=true,
# EXTRA_TIME_BLOCKED_BY_NEXT_JOB=true (defaults)
TRAVEL_BUFFER_MINUTES=30
WORKER_RELEASE_CUTOFF_HOURS=24
UNASSIGNED_ALERT_HOURS=48
# Cleaner assignment: auto (default – best suitable cleaner assigned after
# payment, no accept step) or board (legacy open-job board, for a rollback).
# The admin setting Einstellungen → Richtlinien → Zuweisung overrides it.
ASSIGNMENT_MODE=auto
# Assignment writes use a MongoDB transaction on replica sets; set false to
# force the lock-only fallback (standalone servers use it automatically).
# ASSIGNMENT_TRANSACTIONS=false

# ---------- Operations ----------
# Background jobs run inside the API by default. With a separate worker
# (`npm run worker` / docker-compose "worker" service) set this to false.
RUN_JOBS_IN_API=true
# pino log level: debug | info | warn | error
LOG_LEVEL=info
# Optional error tracking – requires `npm install @sentry/node`; ignored otherwise
SENTRY_DSN=

# ---------- Social login for customers (Google / Apple) ----------
# A provider's button is only shown when ALL of its variables are set.
# Public base of the callback URLs (no trailing slash). Defaults to
# PUBLIC_SITE_URL + /api/v1/auth/oauth (the website proxies /api/v1 to the API).
# Register <base>/google/callback and <base>/apple/callback with the providers.
OAUTH_CALLBACK_BASE_URL=
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer → Identifiers → Services ID (e.g. de.fiduxa.web.signin)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
# Keys → "Sign in with Apple" key: its Key ID and the .p8 file contents
# (one line with \n for line breaks is fine)
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Object storage (S3-compatible, Cloudflare R2) for uploaded documents, CVs,
# complaint photos, cleaner photos and invoice PDFs. PRIVATE bucket, no CORS
# needed (uploads/downloads go through the API). Empty → files stay in MongoDB.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Existing inline files: node src/scripts/migrate-files-to-r2.js --dry-run
S3_ENDPOINT=
ACCESS_KEY_ID_S3=
ACCESS_SECRET_KEY_S3=
R2_BUCKET_NAME=
