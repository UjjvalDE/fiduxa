# Frontend (Next.js)

# Development: leave NEXT_PUBLIC_API_URL empty. The browser calls /api/v1/* on the
# Next.js origin and next.config.js proxies it to the Express API below.
API_PROXY_TARGET=http://localhost:3100

# Production (optional): call the API directly instead of via the proxy.
# Then the API's CLIENT_URL must contain the website origin (CORS).
# NEXT_PUBLIC_API_URL=https://api.example.de/api/v1
