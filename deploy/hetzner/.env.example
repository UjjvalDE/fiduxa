# Copy to deploy/hetzner/.env on the server (never commit the real file).

# Test address, e.g. test.fiduxa.de (DNS A record → server IP)
SITE_DOMAIN=test.fiduxa.de
# Let's Encrypt notices (certificate expiry)
ACME_EMAIL=

# Password gate for testers. Create the hash on the server with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR-PASSWORD'
# and paste it below. In this .env file every "$" in the hash must be written as "$$".
GATE_USER=fiduxa
GATE_PASSWORD_HASH=

# ---------- Monitoring (deploy/hetzner/healthcheck.sh, cron every 5 min) ----------
# Who is told when https://SITE_DOMAIN/ready fails twice in a row (and when it recovers).
# Set at least one of them.
ALERT_EMAIL=
# Slack/Discord/ntfy-style webhook; receives JSON {"text": "..."}
ALERT_WEBHOOK_URL=
# The check has to pass the tester password gate: plain password for GATE_USER (server only)
GATE_PLAIN_PASSWORD=

# ---------- Maintenance & load protection (API) ----------
# true → customers see the maintenance page, admins keep working. Then:
#   docker compose -f deploy/hetzner/docker-compose.yml --env-file deploy/hetzner/.env up -d api
MAINTENANCE_MODE=false
# 503 SERVER_BUSY when more requests are in flight / the event loop lags more (ms)
BUSY_MAX_INFLIGHT=300
BUSY_MAX_LAG_MS=200
