{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Test site: keep it out of search engines
	header X-Robots-Tag "noindex, nofollow"

	# Provider callbacks must reach the API without the password gate
	# (PayPal/Stripe webhooks, Apple's form_post login callback).
	@callbacks path /api/v1/payments/webhook /api/v1/payments/paypal/webhook /api/v1/auth/oauth/*
	handle @callbacks {
		reverse_proxy api:3100
	}

	# Everything else: password gate for testers
	handle {
		basic_auth {
			{$GATE_USER} {$GATE_PASSWORD_HASH}
		}
		@api path /api/* /ready /health
		handle @api {
			reverse_proxy api:3100
		}
		handle {
			reverse_proxy web:3000
		}
	}

	# web or api not answering (container restarting, crashed, deploy in
	# progress): Caddy itself answers 503 – a branded "We'll be right back"
	# page that refreshes itself, or JSON for API calls (the app then shows
	# its "temporarily unavailable" state and polls /ready).
	# Only 502/503/504 are handled here, so the password prompt (401) is untouched.
	handle_errors 502 503 504 {
		header Retry-After 30
		header Cache-Control "no-store"
		@apiDown path /api/* /ready /health
		handle @apiDown {
			header Content-Type "application/json; charset=utf-8"
			respond `{"success":false,"code":"SERVICE_UNAVAILABLE","message":"The service is temporarily unavailable. Please try again in a moment."}` 503
		}
		handle {
			root * /srv/errors
			rewrite * /503.html
			file_server {
				status 503
			}
		}
	}
}
